
Options -MultiViews -Indexes

# GFunnel: keep the underlying platform invisible to outside visitors.
# PHP sources execute rather than reveal themselves, but static give-aways
# (readme/license/changelog/schema/build metadata) are directly fetchable —
# deny them. Guarded by mod_authz_core so it never 500s on older Apache.
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(md|markdown|sql|bak|dist|lock|log|yml|yaml|sh)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(?i)^(readme|license|licence|changelog|install|upgrade|contributing|authors|composer|package(-lock)?)($|\.)">
        Require all denied
    </FilesMatch>
</IfModule>

# Strip the version/platform hints from response headers.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
ServerSignature Off

<IfModule mod_php5.c>
    php_flag allow_url_include Off
    php_flag register_globals Off
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_flag allow_url_include Off
    php_flag register_globals Off
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php.c>
    php_flag allow_url_include Off
    php_flag register_globals Off
    php_value memory_limit 256M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^\.well-known/ - [L]
    # GFunnel: 403 the directories that expose the platform (docs, VCS metadata)
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^\.github(/|$) - [F,L]
    RewriteRule ^docs/ - [F,L]
    # GFunnel SEO: sitemap + robots are generated dynamically (modules/gfunnel/sitemap)
    RewriteRule ^sitemap\.xml$  sitemap.php [QSA,L]
    RewriteRule ^sitemap-([0-9]+)\.xml$  sitemap.php?chunk=$1 [QSA,L]
    RewriteRule ^robots\.txt$  robots.php [L]
    # GFunnel dark-themed auth pages (fall back to stock when gf_auth_pages=off)
    RewriteRule ^login/?$  gf_login.php [QSA,L]
    RewriteRule ^create-account/?$  gf_create_account.php [QSA,L]
    RewriteRule ^m/(.*)$  modules/index.php?r=$1 [QSA,L]
    RewriteRule ^page/(.*)$  page.php?i=$1 [QSA,L]
    RewriteRule ^s/([a-zA-Z0-9_]+)/([a-zA-Z0-9\.]+)  storage.php?o=$1&f=$2   [QSA,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .+ - [L]
    RewriteRule ^(.+)$ r.php?_q=$1 [QSA,L]
</IfModule>

AddType image/svg+xml svg
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

SecFilterEngine Off
SecFilterScanPOST Off
